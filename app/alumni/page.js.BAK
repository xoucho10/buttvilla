# 1. ALUMNI PAGE - Your code but fixed (no double Header/Footer)
New-Item -ItemType Directory -Path app/alumni -Force | Out-Null
@'
"use client";
import { useState, useEffect, useMemo } from "react";
import { supabase } from "../../lib/supabase";

const START_YEAR = 1986;
const CURRENT_YEAR = new Date().getFullYear();
const ALL_YEARS = Array.from({ length: CURRENT_YEAR - START_YEAR + 1 }, (_, i) => CURRENT_YEAR - i);

export default function AlumniPage() {
  const [alumni, setAlumni] = useState([]);
  const [search, setSearch] = useState("");
  const [filterYear, setFilterYear] = useState("all");
  const [expandedYear, setExpandedYear] = useState(null);
  const [showRegister, setShowRegister] = useState(false);
  const [selected, setSelected] = useState(null);
  const [showRequestForm, setShowRequestForm] = useState(false);
  const [form, setForm] = useState({ name: "", year: CURRENT_YEAR, role: "", whatsapp: "", email: "" });
  const [files, setFiles] = useState({ then: null, now: null });
  const [previews, setPreviews] = useState({ then: "", now: "" });
  const [errors, setErrors] = useState({});
  const [uploading, setUploading] = useState(false);

  const avatar = (name, bg="7A0F14") => `https://ui-avatars.com/api/?name=${encodeURIComponent(name || 'Alumni')}&background=${bg}&color=fff`;
  const safeImg = (url, name, bg) => url && url.trim()!==""? url : avatar(name, bg);
  const maskWa = (num) => {
    if(!num) return "";
    const s = num.toString().replace(/\D/g,'');
    if(s.length < 7) return s.slice(0,2) + "****" + s.slice(-2);
    return s.slice(0,4) + "****" + s.slice(-3);
  };

  const fetchAlumni = async () => {
    const { data } = await supabase.from('alumni').select('*').order('year', { ascending: false });
    if (data) {
      setAlumni(data);
      if(data.length>0 &&!expandedYear){
        const latestYear = Math.max(...data.map(a=>a.year));
        setExpandedYear(latestYear);
      }
    }
  };
  useEffect(() => { fetchAlumni(); }, []);

  const filledYears = useMemo(() => {
    const years = [...new Set(alumni.map(a=>a.year))].sort((a,b)=>b-a);
    return years;
  }, [alumni]);

  const filtered = useMemo(()=> alumni.filter(a =>
    a.name.toLowerCase().includes(search.toLowerCase()) &&
    (filterYear==="all" || a.year===Number(filterYear))
  ), [alumni, search, filterYear]);

  const yearsToShow = useMemo(()=>{
    if(filterYear==="all") return filledYears;
    return [Number(filterYear)];
  }, [filterYear, filledYears]);

  const getYearAlumni = (y) => filtered.filter(a=>a.year===y);

  const handleFile = (e, type) => {
    const file = e.target.files[0]; if(!file) return;
    setFiles(p=>({...p, [type]: file}));
    setPreviews(p=>({...p, [type]: URL.createObjectURL(file)}));
  };
  const uploadPhoto = async (file, bucket) => {
    if(!file) return null;
    const name = `${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g,'')}`;
    const { error } = await supabase.storage.from(bucket).upload(name, file);
    if(error) return null;
    return supabase.storage.from(bucket).getPublicUrl(name).data.publicUrl;
  };
  const validate = () => {
    let e = {};
    if(!form.name.trim()) e.name = "Required";
    if(!form.role.trim()) e.role = "Required";
    if(!form.whatsapp.trim()) e.whatsapp = "Required";
    if(!files.now) e.now = "Now picture required *";
    setErrors(e); return Object.keys(e).length===0;
  };
  const handleRegister = async () => {
    if(!validate()) return;
    setUploading(true);
    try {
      const thenUrl = await uploadPhoto(files.then, 'alumni-then');
      const nowUrl = await uploadPhoto(files.now, 'alumni-now');
      await supabase.from('alumni').insert([{
        name: form.name.trim(),
        year: Number(form.year),
        role: form.role.trim(),
        whatsapp: form.whatsapp.trim(),
        email: form.email?.trim() || null,
        photo_then_url: thenUrl,
        photo_now_url: nowUrl,
        is_verified: true
      }]);
      setShowRegister(false);
      setForm({ name: "", year: CURRENT_YEAR, role: "", whatsapp: "", email: "" });
      setFiles({then:null, now:null});
      setPreviews({then:"", now:""});
      fetchAlumni();
      setExpandedYear(Number(form.year));
      setFilterYear("all");
    } catch(err){
      alert("Error: " + err.message);
    } finally {
      setUploading(false);
    }
  };

  const handleRequestSend = async () => {
    const name = document.getElementById('req_name').value;
    const year = document.getElementById('req_year').value;
    const wa = document.getElementById('req_wa').value;
    const msg = document.getElementById('req_msg').value;
    if(!name ||!year ||!wa) return alert("Fill all *");
    await supabase.from('contact_requests').insert([{
      alumni_id: selected.id, requester_name: name,
      requester_year: Number(year), requester_whatsapp: wa, message: msg
    }]);
    const text = encodeURIComponent(`Hello ${selected.name} \nI'm ${name} (Class of ${year}) from Buttvilla Alumni.\n\n${msg || "Connect"}\n\nMy WhatsApp: ${wa}`);
    const cleanNumber = selected.whatsapp.replace(/\D/g,'');
    window.open(`https://wa.me/${cleanNumber}?text=${text}`, '_blank');
    setSelected(null); setShowRequestForm(false);
  };

  return (
    <div className="bg-[#FFFCF7]">
      <div className="max-w-7xl mx-auto px-6 pt-6 pb-2">
        <div className="bg-[#5a0a0f] rounded-[2.5rem] p-8 md:p-12 text-white relative overflow-hidden border-b-[4px] border-[#C5A880]">
          <div className="relative">
            <div className="inline-flex bg-white/10 px-4 py-1.5 rounded-full text-[11px] font-bold tracking-widest border">🎉 1986-{CURRENT_YEAR} • {filledYears.length} FILLED YEARS ONLY • P.O BOX 580 BULAGA</div>
            <h1 className="text-4xl md:text-[46px] font-black mt-4 leading-[0.9]">Once a Buttvilla Child,<br/>Always Family.</h1>
            <p className="mt-3 text-white/70 max-w-2xl text-[13px]">500+ alumni since 1986 mud room to today. Same place 100m Bulaga Post Office. Reddish maroon identity. {alumni.length} alumni in {filledYears.length} groups</p>
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-6 py-4 flex gap-3 flex-wrap items-center bg-white border rounded-full shadow-sm mt-4">
        <div className="flex-1 relative min-w-[200px]"><span className="absolute left-4 top-1/2 -translate-y-1/2">🔍</span><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search classmate..." className="w-full pl-11 pr-4 py-3 rounded-full border bg-[#FFFDF0] text-sm outline-none"/></div>
        <select value={filterYear} onChange={e=>setFilterYear(e.target.value)} className="px-5 py-3 rounded-full border bg-white text-sm font-bold">
          <option value="all">All Filled Years ({filledYears.length})</option>
          {ALL_YEARS.map(y=> <option key={y} value={y}>{y} {filledYears.includes(y)?`• ${alumni.filter(a=>a.year===y).length} alumni`:''}</option>)}
        </select>
        <button onClick={()=>setShowRegister(true)} className="px-8 py-3 rounded-full bg-[#7A0F14] text-white text-sm font-black hover:bg-black shadow">👤 Register Alumni</button>
        <button onClick={fetchAlumni} className="px-4 py-3 rounded-full border bg-white text-sm">↻</button>
      </div>

      <div className="max-w-7xl mx-auto px-6 py-8">
        {alumni.length===0? (
          <div className="bg-white border rounded-[2rem] p-12 text-center">
            <p className="text-5xl">🎓</p>
            <h3 className="font-black text-xl mt-4">No alumni yet - Be first!</h3>
            <button onClick={()=>setShowRegister(true)} className="mt-6 px-8 py-3 rounded-full bg-[#7A0F14] text-white font-bold">Register First Alumni</button>
          </div>
        ) : (
          <div className="space-y-3">
            {yearsToShow.map(year => {
              const list = getYearAlumni(year);
              if(filterYear!=="all" && list.length===0) return (
                <div key={year} className="bg-white border rounded-[2rem] p-8 text-center">
                  <p className="text-sm text-gray-500">No alumni for {year} yet</p>
                  <button onClick={()=>setFilterYear("all")} className="mt-3 text-[#7A0F14] font-bold underline">Show all {filledYears.length} filled years</button>
                </div>
              );
              if(list.length===0) return null;
              return (
                <div key={year} className="bg-white border rounded-[2rem] p-4 shadow-sm">
                  <div className="flex justify-between items-center">
                    <div className="flex items-center gap-3">
                      <div className="bg-[#7A0F14] text-white px-5 py-2 rounded-full text-sm font-bold">{year} • FILLED</div>
                      <div className="flex -space-x-2">{list.slice(0,5).map(a=><img key={a.id} src={safeImg(a.photo_now_url || a.photo_then_url, a.name)} className="w-8 h-8 rounded-full border-2 border-white object-cover" alt=""/>)}</div>
                      <span className="text-sm font-bold">{list.length} alumni in this year</span>
                    </div>
                    <button onClick={()=>setExpandedYear(expandedYear===year?null:year)} className="px-5 py-2 rounded-full border border-[#7A0F14] text-sm font-bold">{expandedYear===year?"Hide":"View"}</button>
                  </div>
                  {expandedYear===year && (
                    <div className="grid md:grid-cols-3 gap-3 pt-4 mt-4 border-t">
                      {list.map(a=>(
                        <div key={a.id} onClick={()=>{setSelected(a); setShowRequestForm(false);}} className="bg-[#FFFCF7] border rounded-2xl p-3 flex gap-3 cursor-pointer hover:shadow hover:-translate-y-0.5 transition">
                          <img src={safeImg(a.photo_then_url, a.name)} className="w-14 h-14 rounded-xl object-cover bg-gray-100"/>
                          <img src={safeImg(a.photo_now_url, a.name)} className="w-14 h-14 rounded-xl object-cover bg-gray-100"/>
                          <div className="flex-1 min-w-0">
                            <p className="font-bold text-sm text-[#7A0F14] truncate">{a.name}</p>
                            <p className="text-[11px]">{a.role} • {a.year}</p>
                            <p className="text-[10px] text-gray-400">WA {maskWa(a.whatsapp)}</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )
            })}
          </div>
        )}
      </div>

      {showRegister && (
        <div className="fixed inset-0 bg-black/60 z-[200] flex items-center justify-center p-4">
          <div className="bg-white w-full max-w-lg rounded-[1.8rem] max-h-[92vh] overflow-y-auto p-6 shadow-2xl">
            <div className="flex justify-between items-start">
              <div>
                <h3 className="font-black text-xl">Register as Alumni</h3>
                <p className="text-[12px] text-gray-500 mt-1">P.O Box 580 Bulaga • Since 1986</p>
              </div>
              <button onClick={()=>setShowRegister(false)} className="w-9 h-9 bg-black text-white rounded-full grid place-items-center">✕</button>
            </div>
            <div className="grid grid-cols-2 gap-3 mt-5">
              <label className="border-2 border-dashed rounded-xl p-3 text-center cursor-pointer">
                <input type="file" hidden onChange={e=>handleFile(e,'then')} accept="image/*"/>
                <p className="text-[11px] font-bold">Then Photo (Optional)</p>
                <div className="w-16 h-16 mx-auto mt-2 rounded-full bg-gray-100 overflow-hidden border grid place-items-center">{previews.then? <img src={previews.then} className="w-full h-full object-cover"/> : <span className="text-[10px] text-gray-400">Baby</span>}</div>
              </label>
              <label className={`border-2 border-dashed rounded-xl p-3 text-center cursor-pointer ${errors.now?'border-red-500 bg-red-50':''}`}>
                <input type="file" hidden onChange={e=>handleFile(e,'now')} accept="image/*"/>
                <p className="text-[11px] font-bold">Now Photo * Required</p>
                <div className="w-16 h-16 mx-auto mt-2 rounded-full bg-gray-100 overflow-hidden border grid place-items-center">{previews.now? <img src={previews.now} className="w-full h-full object-cover"/> : <span className="text-[10px] text-gray-400">Required</span>}</div>
                {errors.now && <p className="text-[10px] text-red-500 mt-1">{errors.now}</p>}
              </label>
            </div>
            <div className="space-y-3 mt-5">
              <input value={form.name} onChange={e=>setForm({...form,name:e.target.value})} placeholder="Full name * e.g salim hussein" className={`w-full p-3 rounded-xl border text-sm ${errors.name?'border-red-500':''}`}/>
              <select value={form.year} onChange={e=>setForm({...form,year:e.target.value})} className="w-full p-3 rounded-xl border text-sm font-bold">
                {ALL_YEARS.map(y=><option key={y} value={y}>{y} {filledYears.includes(y)?`• ${alumni.filter(a=>a.year===y).length} already`:''} </option>)}
              </select>
              <input value={form.role} onChange={e=>setForm({...form,role:e.target.value})} placeholder="Current job / role * e.g IT" className={`w-full p-3 rounded-xl border text-sm ${errors.role?'border-red-500':''}`}/>
              <input value={form.whatsapp} onChange={e=>setForm({...form,whatsapp:e.target.value})} placeholder="WhatsApp * e.g 0700***123" className={`w-full p-3 rounded-xl border text-sm ${errors.whatsapp?'border-red-500':''}`}/>
              <input value={form.email} onChange={e=>setForm({...form,email:e.target.value})} placeholder="Email (Optional)" className="w-full p-3 rounded-xl border text-sm bg-gray-50"/>
            </div>
            <button disabled={uploading} onClick={handleRegister} className="w-full mt-6 py-4 rounded-xl bg-[#7A0F14] text-white font-black hover:bg-black disabled:opacity-50">
              {uploading?"Uploading...":"Submit - Save to Cloud"}
            </button>
          </div>
        </div>
      )}

      {selected && (
        <div className="fixed inset-0 bg-black/60 z-[150] flex items-center justify-center p-4" onClick={()=>setSelected(null)}>
          <div className="bg-white w-full max-w-md rounded-[2rem] p-6" onClick={e=>e.stopPropagation()}>
            {!showRequestForm? (
              <>
                <div className="flex justify-between"><h3 className="font-bold text-xl text-[#7A0F14]">{selected.name}</h3><button onClick={()=>setSelected(null)} className="w-8 h-8 bg-black text-white rounded-full grid place-items-center">✕</button></div>
                <div className="grid grid-cols-2 gap-3 mt-4">
                  <div><p className="text-[10px] text-gray-400 mb-1">THEN</p><img src={safeImg(selected.photo_then_url, selected.name)} className="w-full h-44 rounded-2xl object-cover bg-gray-100"/></div>
                  <div><p className="text-[10px] text-gray-400 mb-1">NOW</p><img src={safeImg(selected.photo_now_url, selected.name)} className="w-full h-44 rounded-2xl object-cover bg-gray-100"/></div>
                </div>
                <div className="mt-4 bg-[#FFFCF7] p-4 rounded-2xl border text-sm"><p><b>Year:</b> {selected.year}</p><p><b>Role:</b> {selected.role}</p><p><b>WhatsApp:</b> {maskWa(selected.whatsapp)} hidden</p></div>
                <button onClick={()=>setShowRequestForm(true)} className="w-full mt-4 py-3 rounded-full bg-[#7A0F14] text-white font-bold">Request Contact →</button>
              </>
            ) : (
              <>
                <h3 className="font-bold">Contact {selected.name}</h3>
                <div className="space-y-3 mt-4">
                  <input id="req_name" placeholder="Your full name *" className="w-full p-3 rounded-xl border text-sm"/>
                  <input id="req_year" placeholder="Your year *" type="number" min={START_YEAR} max={CURRENT_YEAR} className="w-full p-3 rounded-xl border text-sm"/>
                  <input id="req_wa" placeholder="Your WhatsApp *" className="w-full p-3 rounded-xl border text-sm"/>
                  <textarea id="req_msg" placeholder="Message" className="w-full p-3 rounded-xl border text-sm h-20"></textarea>
                </div>
                <div className="grid grid-cols-2 gap-3 mt-4">
                  <button onClick={()=>setShowRequestForm(false)} className="py-3 rounded-full border font-bold text-sm">Back</button>
                  <button onClick={handleRequestSend} className="py-3 rounded-full bg-green-600 text-white font-bold text-sm">Send WhatsApp</button>
                </div>
              </>
            )}
          </div>
        </div>
      )}
    </div>
  )
}
'@ | Set-Content -Path app/alumni/page.js -Encoding UTF8

# 2. LEGACY REDIRECTS TO ALUMNI - FIXES YOUR 404
New-Item -ItemType Directory -Path app/alumni -Force | Out-Null
@'
import { redirect } from "next/navigation";
export default function LegacyRedirect(){
  redirect("/alumni");
}
'@ | Set-Content -Path app/alumni/page.js -Encoding UTF8

Remove-Item -Recurse -Force.next -ErrorAction SilentlyContinue
Write-Host "=== DONE: /alumni -> /alumni redirect, alumni page fixed no double header ===" -ForegroundColor Green
Write-Host "Run: npm run dev"
Write-Host "Test: http://localhost:3000/alumni -> will go to /alumni"
Write-Host "Test: http://localhost:3000/alumni -> your full alumni code"
